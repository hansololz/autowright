#!/usr/bin/env python3
# Contract pair (§15): tests/bin/claude.py is this file's Windows twin.
"""Fake `claude` CLI for tests (tests/bin is prepended to PATH by conftest).

The backend invokes agents only by shelling out to the real CLI, so tests get a
deterministic stand-in binary instead of a mock code path inside the app. It
answers `--version` and one-shot `claude -p ... <prompt>` calls with canned
envelopes matching the §8 drafting contract.

Prompt delivery mirrors the real CLI (§15): the positional argv prompt when
one is given (the §8 POSIX form, after the `--` separator), otherwise the
whole of stdin (the §8 Windows form, where the prompt is too long for a
command line and rides the pipe instead).
"""
import json
import os
import re
import sys
import time

SPEC_ENVELOPE = """===FILE: spec.md===
# {title}

{desc}

## Schedule

Every day at 8:00.

## What it does

- Fetches what it needs and checks for anything new.
- Builds a short result you can read at a glance.
===END===
"""

STEPS_ENVELOPE = """===FILE: manifest.yaml===
note: Drafted by the mock agent
params:
  - { name: notify_only_on_changes, kind: toggle, label: Notify only on changes, help: Skip the notification when nothing is new., default: true }
steps:
  - { file: 01-check.py, name: Check for changes, desc: Looks for anything new since the last run. }
  - { file: 02-report.py, name: Build the result, desc: Summarizes what it found. }
===FILE: 01-check.py===
from autowright import log, memory

found = []
log("checked — nothing to do in mock mode")
memory.save("last_check", {"found": len(found)})
===FILE: 02-report.py===
from autowright import notify, params, result

result.status("ok")
result.chip("All good")
(result.path / "result.md").write_text("Mock run — nothing new.")
if not params["notify_only_on_changes"]:
    notify("Mock run finished")
===END===
"""


BLOCKED_ENVELOPE = """===BLOCKED===
blockers:
  - reason: The task needs access to physical mail.
    fix: Point it at a digital source instead.
    details: Autowright scripts can only read files and web pages.
===END===
"""

# §8 kind: user-action — the fix is something the USER does on their Mac
USER_ACTION_ENVELOPE = """===BLOCKED===
blockers:
  - reason: Transmission isn't installed on this Mac.
    fix: Download it from [transmissionbt.com](https://transmissionbt.com/download.html) and install it, then run the automation again.
    details: The automation drives Transmission's RPC interface, so it can't run until the app is installed and open. Want step-by-step install instructions?
    kind: user-action
===END===
"""


def respond(prompt: str) -> str:
    if "question:" in prompt.lower() and "=== TASK ===" not in prompt:
        return "Mock answer: nothing new."
    # §8 chat call (§11 chat pane) — the response shape decides the outcome:
    # a question-shaped request gets prose, "fix-and-test" the full multi-block
    # response (rewrites + actions), anything else the spec rewrite.
    if "Decide what the USER REQUEST" in prompt:
        m = re.search(r"=== USER REQUEST ===\n(.+)", prompt)
        user = (m.group(1) if m else "").strip()
        if "blocked-chat" in user.lower():
            return BLOCKED_ENVELOPE
        if "install-blocked" in user.lower():
            return USER_ACTION_ENVELOPE
        if "undo" in user.lower():
            # §8 undo action — always alone (no rewrites, no other actions)
            return ("Rolling the draft back.\n"
                    "===FILE: actions.yaml===\nundo: true\n===END===\n")
        if "stage-actions" in user.lower():
            # §8 param_values + triggers ops — staged, land when the user saves
            return ("Staged the value and the evening schedule — they apply when you save.\n"
                    "===FILE: actions.yaml===\n"
                    "param_values: { notify_only_on_changes: false }\n"
                    "triggers:\n"
                    "  - add: { cron: \"0 21 * * *\" }\n"
                    "===END===\n")
        if "stage-concurrency" in user.lower():
            # §8 `concurrency` action — staged, lands when the user saves
            return ("Staged the concurrency change — it applies when you save.\n"
                    "===FILE: actions.yaml===\n"
                    "concurrency: { max_parallel: 2, max_queued: 3 }\n"
                    "===END===\n")
        if "fix-and-test" in user.lower():
            spec = SPEC_ENVELOPE.format(title="Fixed automation",
                                        desc="Fixed by the mock agent.").split("===END===")[0]
            return ("Fixed — rebuilding the steps and running a test.\n"
                    + spec
                    + "===FILE: notes.md===\n- Mock note: the fix-and-test path was exercised.\n"
                    + "===FILE: actions.yaml===\nsync: true\ntest: true\n===END===\n")
        if user.endswith("?"):
            return ("The workflow has two steps: **Check for changes** looks for anything new "
                    "since the last run, and **Build the result** summarizes what it found.")
        # §8 new-automation rule: an empty SPEC section marks a fresh draft —
        # write the spec, name the automation via actions, and chain the sync.
        sm = re.search(r"=== SPEC \(spec\.md[^)]*\) ===\n(.*?)(?:\n=== |\Z)", prompt, re.S)
        title = user.rstrip(".")[:48].capitalize() or "New automation"
        if not (sm.group(1).strip() if sm else ""):
            spec = SPEC_ENVELOPE.format(
                title=title, desc=f"{title} — drafted by the mock agent.").split("===END===")[0]
            return ("Drafting the spec and building the steps.\n"
                    + spec
                    + "===FILE: actions.yaml===\n"
                    + f"name: {title}\n"
                    + f"description: {title} — drafted by the mock agent.\n"
                    + "sync: true\n===END===\n")
        return SPEC_ENVELOPE.format(title=title, desc=f"{title} — rewritten by the mock agent.")
    # §8 blocker envelope on demand: "blocked-steps" blocks the sync call
    # (it reaches the sync via the spec title).
    if "blocked-steps" in prompt.lower() and "Build the automation that implements the SPEC" in prompt:
        return BLOCKED_ENVELOPE
    if "Build the automation that implements the SPEC" in prompt:
        # §8 sync call — manifest + step files (no name/description keys)
        return STEPS_ENVELOPE
    return "Mock answer: nothing to do."


def main() -> None:
    args = sys.argv[1:]
    if (args == ["auth", "status"]
            and os.environ.get("AUTOWRIGHT_TEST_CLAUDE_SIGNED_OUT") == "1"):
        # §19 sign-in knob: the real `signed_in("claude")` check shells out to
        # `claude auth status` and reads only the exit code.
        sys.stderr.write("Not signed in\n")
        sys.exit(1)
    if "--version" in args:
        print("0.0.0 (autowright test fake)")
        return
    # §15 prompt delivery, mirroring the real CLI: the positional prompt after
    # the `--` separator when one is given (§8 POSIX form), else the whole of
    # stdin (§8 Windows form — the prompt is piped, never in argv). The plain
    # last-argv fallback keeps every non-`-p` invocation (`auth status`, …)
    # behaving exactly as before, and never touches stdin.
    positional = args[args.index("--") + 1:] if "--" in args else []
    if positional:
        prompt = positional[-1]
    elif "-p" in args:
        prompt = sys.stdin.read()
    else:
        prompt = args[-1] if args else ""
    text = respond(prompt)
    if "stream-json" in args:
        # §8 live progress: the backend reads stream-json — emit the reply as
        # per-line text deltas, then the terminal result event with the full
        # text. AUTOWRIGHT_TEST_STREAM_DELAY_MS paces the stream (manual UI
        # verification); unset → instant, so the pytest suite stays fast.
        delay = float(os.environ.get("AUTOWRIGHT_TEST_STREAM_DELAY_MS") or 0) / 1000
        if "WebFetch,WebSearch" in args:
            # web-enabled drafting call: one tool_use like the real CLI
            # reports, so the §8 activity feed has a tool event to show
            sys.stdout.write(json.dumps({"type": "assistant", "message": {"content": [
                {"type": "tool_use", "name": "WebFetch",
                 "input": {"url": "https://example.com/docs"}}]}}) + "\n")
            sys.stdout.flush()
            if delay:
                time.sleep(delay * 3)
        for ln in text.splitlines(keepends=True):
            sys.stdout.write(json.dumps({
                "type": "stream_event",
                "event": {"type": "content_block_delta",
                          "delta": {"type": "text_delta", "text": ln}},
            }) + "\n")
            sys.stdout.flush()
            if delay:
                time.sleep(delay)
        sys.stdout.write(json.dumps({"type": "result", "subtype": "success",
                                     "result": text}) + "\n")
        return
    sys.stdout.write(text)


if __name__ == "__main__":
    main()
