{
  "name": "autowright",
  "productName": "Autowright",
  "version": "0.11.4",
  "private": true,
  "license": "MIT",
  "description": "Recurring jobs, done exactly the same way every time.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "app": "electron .",
    "postinstall": "node brand-electron.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "desktopName": "ai.autowright.app.desktop",
  "build": {
    "appId": "ai.autowright.app",
    "productName": "Autowright",
    "copyright": "Copyright © David Zhang",
    "directories": {
      "output": "../build/win"
    },
    "artifactName": "Autowright.${ext}",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/hansololz/autowright/main/release/win32-x86_64/"
      }
    ],
    "files": [
      "package.json",
      "electron/**/*",
      "dist/**/*",
      "!node_modules/@fontsource/**",
      "!node_modules/@fortawesome/**",
      "!node_modules/@types/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-gfm/**",
      "!node_modules/scheduler/**",
      "!node_modules/zustand/**"
    ],
    "extraResources": [
      {
        "from": "../build/python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon/icon.png",
      "syncDesktopName": true,
      "category": "Utility",
      "synopsis": "Recurring personal automations",
      "publish": [
        {
          "provider": "generic",
          "url": "https://raw.githubusercontent.com/hansololz/autowright/main/release/linux-x86_64/"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "guid": "3E71053D-7CAA-4BF9-A643-93ABDA35B1F3",
      "createStartMenuShortcut": true,
      "shortcutName": "Autowright",
      "menuCategory": false,
      "installerIcon": "electron/icon/icon.ico",
      "uninstallerIcon": "electron/icon/icon.ico",
      "include": "electron/installer.nsh"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.12.0",
    "playwright-core": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
